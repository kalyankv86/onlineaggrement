{
  "name": "gtids-agreement-api",
  "version": "1.0.0",
  "private": true,
  "description": "GTIDS Online Agreement Management & Digital Signing Portal — API",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && npm run build:db",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker": "ts-node -r tsconfig-paths/register src/worker.ts",
    "migrate": "knex --knexfile knexfile.cjs migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.cjs migrate:rollback",
    "seed": "knex --knexfile knexfile.cjs seed:run",
    "db:reset": "ts-node scripts/reset-db.ts && npm run migrate && npm run seed",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --testPathPatterns=test/unit",
    "test:integration": "jest --config jest.config.js --testPathPatterns=test/integration --runInBand",
    "test:e2e": "jest --config jest.config.js --testPathPatterns=test/e2e --runInBand",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "demo": "ts-node -T scripts/demo-workflow.ts",
    "deploy:local": "bash ../deploy/local/start.sh",
    "deploy:local:stop": "bash ../deploy/local/stop.sh",
    "create-user": "ts-node -T src/scripts/create-user.ts",
    "build:db": "tsc -p tsconfig.db.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "knex": "^3.1.0",
    "node-forge": "^1.3.1",
    "nodemailer": "^6.9.16",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "playwright": "^1.62.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/node-forge": "^1.3.11",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
