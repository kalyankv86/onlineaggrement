# ── GTIDS Agreement Portal — API configuration ───────────────────────────────
# Copy to .env for local development. Never commit .env (SDD §13: secrets outside
# source code). In production these come from the secret store, not a file.

NODE_ENV=development
PORT=3100
API_BASE_URL=http://localhost:3100

# The QR printed on a completed agreement encodes this URL. It must point at the
# WEB UI's verification page, not at the API — a counterparty scanning the code
# with a phone should get a readable answer, not a JSON document.
PUBLIC_VERIFY_BASE_URL=http://localhost:3101/verify

# ── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL is the *application* role: no UPDATE/DELETE on audit_logs (DEC-011).
# MIGRATION_DATABASE_URL is the owner role, used only by `npm run migrate`.
DATABASE_URL=postgresql://localhost:5432/gtids_agreements
MIGRATION_DATABASE_URL=postgresql://localhost:5432/gtids_agreements
TEST_DATABASE_URL=postgresql://localhost:5432/gtids_agreements_test

# ── Redis (BullMQ) ───────────────────────────────────────────────────────────
# AOF persistence must be on in production — job durability depends on it.
REDIS_URL=redis://localhost:6379

# ── Document storage (SDD v1.1 §B8) ──────────────────────────────────────────
# Documents live on a GTIDS-owned NAS export mounted on this server.
# STORAGE_FS_ROOT is the mountpoint and must be absolute in production. A marker
# file named .gtids-storage-root must exist inside it: if the export is not
# mounted the service refuses to start, rather than silently writing executed
# agreements to the local disk where they vanish when the NAS returns.
STORAGE_FS_ROOT=./storage
# Pre-signed download URLs must be short-lived (SRS §12).
STORAGE_SIGNED_URL_TTL_SECONDS=300

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-every-environment
JWT_ACCESS_TTL=30m
JWT_ABSOLUTE_TTL=12h
PARTY_ACCESS_TOKEN_TTL_HOURS=72
BCRYPT_ROUNDS=12

# ── eSign provider (DEC-002) ─────────────────────────────────────────────────
# mock: development and CI. Replace with the contracted ESP/ASP adapter name.
ESIGN_PROVIDER=mock
ESIGN_CALLBACK_SECRET=change-me
ESIGN_CALLBACK_TOLERANCE_SECONDS=300
ESIGN_TRANSACTION_TTL_MINUTES=30

# ── PDF pipeline ─────────────────────────────────────────────────────────────
# pdflib: dependency-free, used in dev/CI.  playwright: production HTML renderer
# (requires `npm i playwright && npx playwright install chromium`).
PDF_RENDERER=pdflib
PDF_SIGNATURE_RESERVED_BYTES=8192

# ── Email (DEC-020) ──────────────────────────────────────────────────────────
# json: writes messages to the log instead of sending. Use for dev and CI.
SMTP_TRANSPORT=json
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="GTIDS Agreements <agreements@gtids.example>"

# ── Workflow policy (DEC-008) ────────────────────────────────────────────────
DEFAULT_STAGE_SLA_DAYS=14
DEFAULT_REMINDER_DAYS=3,7,12
MAX_SIGNATURE_ATTEMPTS=3

# ── Rate limiting (DEC-006) ──────────────────────────────────────────────────
VERIFY_RATE_LIMIT_PER_MINUTE=10
