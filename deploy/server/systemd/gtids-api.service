[Unit]
Description=GTIDS Agreement Portal — API
Documentation=file:///opt/gtids-agreements/current/docs/RUNBOOK.md
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service
# The document store is a NAS export. Starting before it is mounted would make
# the API fail its storage check and flap; RequiresMountsFor makes systemd wait.
RequiresMountsFor=/srv/gtids/agreements

[Service]
Type=simple
User=gtids
Group=gtids
WorkingDirectory=/opt/gtids-agreements/current/api
EnvironmentFile=/etc/gtids/api.env
ExecStart=/usr/bin/node dist/main.js

# The API must not run the scheduled jobs; that is the worker's role, so a PDF
# render cannot compete with a signer's request for the same event loop.
Environment=RUN_SCHEDULER=false

# Chromium lives outside /home because ProtectHome=true hides it there.
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/gtids-agreements/browsers

Restart=on-failure
RestartSec=5s
# If it cannot stay up for 5 tries in 2 minutes, stop and page someone rather
# than restart-looping against a broken database or an unmounted NAS.
StartLimitBurst=5
StartLimitIntervalSec=120

# Give in-flight signing requests a chance to finish before the process dies.
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=append:/var/log/gtids/api.log
StandardError=append:/var/log/gtids/api.log

# ── Hardening ────────────────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
# The only paths the service may write to.
ReadWritePaths=/srv/gtids/agreements /var/log/gtids
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
