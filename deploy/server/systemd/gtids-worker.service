[Unit]
Description=GTIDS Agreement Portal — background worker
Documentation=file:///opt/gtids-agreements/current/docs/RUNBOOK.md
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service
# The worker is the only process that must never be run twice.
# The document store is a NAS export. Starting before it is mounted would make
# the API fail its storage check and flap; RequiresMountsFor makes systemd wait.
RequiresMountsFor=/srv/gtids/agreements

# Rate limit restarts. These belong in [Unit] — systemd ignores them in
# [Service] and logs 'Unknown key name'.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=gtids
Group=gtids
WorkingDirectory=/opt/gtids-agreements/current/api
EnvironmentFile=/etc/gtids/api.env
ExecStart=/usr/bin/node dist/worker.js

# This process owns every scheduled job: notification dispatch, provider
# reconciliation, the SLA sweep, and the daily audit-chain and document
# integrity checks. Exactly one worker should run.
Environment=RUN_SCHEDULER=true

# Chromium lives outside /home because ProtectHome=true hides it there.
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/gtids-agreements/browsers

# always, not on-failure: a clean exit still means the worker has stopped
# dispatching notifications and reconciling signatures, which is a fault.
Restart=always
RestartSec=5s

# Give in-flight signing requests a chance to finish before the process dies.
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=append:/var/log/gtids/worker.log
StandardError=append:/var/log/gtids/worker.log

# ── Hardening ────────────────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
# The only paths the service may write to.
ReadWritePaths=/srv/gtids/agreements /var/log/gtids
# AF_NETLINK is required: Node calls os.networkInterfaces() when a server
# starts listening, which goes through getifaddrs() and opens a netlink
# socket. Without it the process dies with EAFNOSUPPORT (errno 97) before
# serving anything.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
